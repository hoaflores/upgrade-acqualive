{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "acqualive-mcp",
      "version": "0.1.0",
      "title": "Acqualive MCP"
    },
    "tools": [
      {
        "name": "list_franqueados",
        "title": "Listar franqueados Acqualive",
        "description": "Lista franqueados/especialistas Acqualive ativos. Opcionalmente filtre por estado (UF) ou cidade.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "estado": {
              "description": "UF, ex: SP, RJ",
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            },
            "cidade": {
              "description": "Nome da cidade (busca parcial)",
              "type": "string"
            },
            "limit": {
              "description": "Máximo de resultados (padrão 50)",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
